# 构建输出目录
dist/

# 依赖目录
node_modules/

# Yarn / npm 锁文件（按需要可改为提交；当前选择不提交，避免跨机差异）
yarn.lock

# ============ .NET / C# 编译缓存（历史：daemon 项目已随 M4 删除） ============
# 这些是可以从源码重新编译的缓存，绝不应提交到 GitHub
bin/
obj/
*.user
*.suo
*.userprefs
.vs/
*.pdb
*.cache

# 笔输入层平滑 + 键盘钩子合体后的 .8li（native/JWautofillHost/）：
# ⛔ .8li / .dll 必须入库：用户机器没有 zig 工具链，部署直接取 build/ 下的产物。
# zig 顺带产出的 .lib / .pdb 不需要（.pdb 已被上面的 *.pdb 覆盖）。
native/JWautofillHost/build/*.lib

# ============ TypeScript / 构建中间产物 ============
*.tsbuildinfo

# ============ 日志 ============
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============ 编辑器 / 系统 ============
.vscode/
.DS_Store
Thumbs.db

# ============ 分析 / 原型 / 调试产物（本地开发草稿，不入库） ============
# analysis/：原型算法、测试脚本、生成图与日志、.npy 等，yarn build 与插件运行均不依赖。
# outputs/：原生守护进程编译缓存(daemon_obj)、调试日志等。
# 二者仅本地保留，取消 git 跟踪后不再推送远程。
analysis/
outputs/
