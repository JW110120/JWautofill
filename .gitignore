# 构建输出目录
dist/

# 依赖目录
node_modules/

# Yarn / npm 锁文件（按需要可改为提交；当前选择不提交，避免跨机差异）
yarn.lock

# ============ .NET / C# 编译缓存（原生守护进程） ============
# 这些是可以从源码重新编译的缓存，绝不应提交到 GitHub
native/HotkeyDaemon/bin/
native/HotkeyDaemon/obj/
bin/
obj/
*.user
*.suo
*.userprefs
.vs/
*.pdb
*.cache

# 例外：守护进程预编译「自包含单文件 exe」随插件分发，安装时直接复制，
# 用户机器无需安装 .NET SDK / 运行时。这是必要的发布物，必须入库。
!native/HotkeyDaemon/publish/JWautofillHotkeyDaemon.exe

# ============ TypeScript / 构建中间产物 ============
*.tsbuildinfo

# ============ 日志 ============
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============ 编辑器 / 系统 ============
.vscode/
.DS_Store
Thumbs.db

# ============ 分析 / 原型 / 调试产物（本地开发草稿，不入库） ============
# analysis/：原型算法、测试脚本、生成图与日志、.npy 等，yarn build 与插件运行均不依赖。
# outputs/：原生守护进程编译缓存(daemon_obj)、调试日志等。
# 二者仅本地保留，取消 git 跟踪后不再推送远程。
analysis/
outputs/
