{
    "manifestVersion": 4,
    "name": "易修",
    "version": "2.0.0",
    "host": {
        "app": "PS",
        "minVersion": "23.0.0"
    },
    "main": "index.html",
    "entrypoints": [
        {
            "id": "com.listen2me.jwautofill",
            "label": {
                "default": "选区填充"
            },
            "type": "panel",
            "minimumSize": {
                "width": 250,
                "height": 450 
            },
            "maximumSize": {
                "width": 250,
                "height": 5000
            },
            "preferredDockedSize": {
                "width": 250,
                "height": 5000

            },
            "preferredFloatingSize": {
                "width": 250,
                "height": 1000
            },
            "icons": [
                {
                    "path": "icons/App/light-panel.png",
                    "width": 23,
                    "height": 23,
                    "scale": [1,2],
                    "theme": ["darkest", "dark", "medium"],
                    "species": ["chrome"]
                },
                {
                    "path": "icons/App/dark-panel.png",
                    "width": 23,
                    "height": 23,
                    "scale": [1,2],
                    "theme": ["lightest", "light"],
                    "species": ["chrome"]
                } 
            ]
        },
        {
            "id": "com.listen2me.pixeladjustment",
            "label": {
                "default": "绘画工具箱"
            },
            "type": "panel",
            "minimumSize": {
                "width": 250,
                "height": 450 
            },
            "maximumSize": {
                "width": 250,
                "height": 5000
            },
            "preferredDockedSize": {
                "width": 250,
                "height": 5000
            },
            "preferredFloatingSize": {
                "width": 250,
                "height": 1000
            },
            "icons": [
                {
                    "path": "icons/AdjustmentPanel/light-panel.png",
                    "width": 23,
                    "height": 23,
                    "scale": [1,2],
                    "theme": ["darkest", "dark", "medium"],
                    "species": ["chrome"]
                },
                {
                    "path": "icons/AdjustmentPanel/dark-panel.png",
                    "width": 23,
                    "height": 23,
                    "scale": [1,2],
                    "theme": ["lightest", "light"],
                    "species": ["chrome"]
                } 
            ]
        }
    ],
    "id": "com.listen2me.jwautofill",
    "icons": [
        {
            "path": "icons/App/plugin.png",
            "width": 48,
            "height": 48,
            "scale": [1,2],
            "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
            "species": ["pluginList"]
        }
    ],
    "requiredPermissions": {
        "clipboard": "readAndWrite",
        "network": {
            "domains": "all"
        },
        "allowCodeGenerationFromStrings": true,
        "launchProcess": {
            "schemes": ["http", "https"],
            "extensions": [".exe", ".bat", ".cmd", ".ps1", ""]
        },
        "localFileSystem": "fullAccess"
    },
    "build": {
        "cssResources": ["common.css"],
        "featureFlags": {
            "CSSNextSupport": true
        }
    }
}
