<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>FixKeyboard</AssemblyName>
    <RootNamespace>JWautofill</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyVersion>2026.9.6.1</AssemblyVersion>
    <FileVersion>2026.9.6.1</FileVersion>
    <!-- 单文件自包含：目标机无需预装 .NET 运行时，双击即可运行 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- 控制台程序：被 UXP shell.openPath 唤起时会自带可见窗口 -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

</Project>
