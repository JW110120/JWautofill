<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows GUI 子系统：守护进程全程无窗口运行（不再弹出 cmd/控制台）。
         日志改为写入文件（见 Program.cs RedirectConsoleToFile），排障信息不丢失。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JWautofillHotkeyDaemon</AssemblyName>
    <RootNamespace>JWautofillHotkeyDaemon</RootNamespace>
    <!-- 单文件发布，便于随插件分发 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 守护进程仅面向 Windows（GUI 子系统 + 注册表自启），平台兼容性告警无意义 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
